diff --git a/dlls/winemac.drv/glmt.c b/dlls/winemac.drv/glmt.c
new file mode 100644
index 00000000000..2aaa63361bb
--- /dev/null
+++ b/dlls/winemac.drv/glmt.c
@@ -0,0 +1,391 @@
